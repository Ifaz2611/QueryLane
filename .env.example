# Local development only. The grading harness injects the real values;
# the container must never bundle or hardcode any of these.
FIREWORKS_API_KEY=fw_your_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
ALLOWED_MODELS=accounts/fireworks/models/minimax-m3,accounts/fireworks/models/kimi-k2p7-code

# Optional routing and specialist tuning. Defaults shown; uncomment to override.
# ROUTER_MIN_CONFIDENCE=0.70
# NER_SPECIALIST=on
# NER_MIN_CONFIDENCE=0.85
# NER_MIN_MARGIN=0.05
# NER_COMPLETENESS_GUARD=on

# Observability (off by default; neither costs tokens unless you call the cloud).
# AGENT_DEBUG=1            # per-call token lines (human readable)
# AGENT_LOG_JSON=1         # one JSON event per task/cloud call
# METRICS_PATH=metrics.json
# AGENT_DRY_RUN=1          # same as: python -m agent.main --dry-run
# CLOUD_TASK_BUDGET=75     # hard per-task cloud time budget (seconds)
# CLOUD_BACKOFF_BASE=0.5
# CLOUD_BACKOFF_CAP=8.0
