# v15: activation fix for slow graders. Per-category speed bars let math, NER,
# and factual degrade individually instead of disabling all local inference.
# A/B evidence: ft-1.5b factual 5/5, math 5/5; summarization regressed after
# fine-tuning (0/5) so it must NOT be promoted.
# Base tag python:3.11-slim is pinned by manifest digest; see Dockerfile.
FROM python:3.11-slim@sha256:673719e071ecf27434fd2635bbd8d00f49f4fdd81f243143438a42ced8bedf60
LABEL org.opencontainers.image.title="QueryLane" \
      org.opencontainers.image.description="Cost-aware LLM query routing (v15 adaptive hybrid image)"

ENV HOME=/home/querylane \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN groupadd --gid 10001 querylane \
 && useradd --uid 10001 --gid querylane --create-home \
      --home-dir /home/querylane --shell /usr/sbin/nologin querylane \
 && mkdir -p /output \
 && chown -R querylane:querylane /app /output /home/querylane

# One lock covers the local GGUF runtime and the ONNX specialist runtimes.
COPY requirements-hybrid.lock ./
RUN pip install --no-cache-dir -r requirements-hybrid.lock \
      --extra-index-url https://abetlen.github.io/llama-cpp-python/whl/cpu \
      --only-binary=llama-cpp-python

COPY --chown=querylane:querylane models/ft-1.5b-q4_k_m.gguf ./models/model.gguf
COPY --chown=querylane:querylane models/ner/ ./models/ner/
COPY --chown=querylane:querylane models/sst2/ ./models/sst2/

COPY --chown=querylane:querylane agent/ ./agent/

ENV LOCAL_CATEGORIES="factual,math,ner"
ENV LOCAL_MODEL_PATH="/app/models/model.gguf"
ENV LOCAL_MIN_TPS="0.4"

USER querylane

ENTRYPOINT ["python", "-m", "agent.main"]
